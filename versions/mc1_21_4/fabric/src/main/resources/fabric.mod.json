{
  "schemaVersion": 1,
  "id": "bettersearch",
  "version": "${version}",
  "name": "Better Search",
  "description": "Makes search bars smarter and better!",
  "authors": [
    "rivalzin"
  ],
  "contact": {
    "homepage": "https://www.youtube.com/@Rivalzln",
    "issues": "https://github.com/rivalzin/BetterSearch/issues"
  },
  "license": "MIT",
  "icon": "assets/bettersearch/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.rivalzin.bettersearch.fabric.BetterSearchFabric"
    ],
    "modmenu": [
      "com.rivalzin.bettersearch.fabric.BetterSearchModMenu"
    ]
  },
  "mixins": [
    "bettersearch.mixins.json",
    "bettersearch-emi.mixins.json",
    "bettersearch-rei.mixins.json",
    "bettersearch-fabric.mixins.json",
    "bettersearch-toms.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.4 <1.21.5",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
